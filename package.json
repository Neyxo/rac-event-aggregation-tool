{
  "name": "rotaract-events",
  "private": true,
  "homepage": "https://neyxo.github.io/rotaract-events/",
  "repository": "https://github.com/Neyxo/rotaract-events",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "TZ=Europe/Zurich vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint web/src && biome check --error-on-warnings",
    "format": "biome format --write",
    "e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "version": "0.14.3",
  "license": "PolyForm-Noncommercial-1.0.0"
}
